[Unit]
Description=MeetFlow Daphne ASGI Server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/meeting-room/src
EnvironmentFile=/home/ubuntu/meeting-room/.env
ExecStart=/home/ubuntu/meeting-room/venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
